@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
hide footbox
title UC-01 Request / Book Appointment: selectSlot

participant "<u>:AppointmentController</u>" as Ctrl
participant "<u>mp:MedicalProfessional</u>" as MP
collections "<u>:AvailabilitySlot</u>" as Ss
participant "<u>s:AvailabilitySlot</u>" as S

[-> Ctrl : selectSlot(slotId)
Ctrl -> MP : s := getSlot(slotId)
MP -> Ss : s := find(slotId)
Ss --> MP : s
MP --> Ctrl : s
Ctrl -> S : available := isAvailable()
S --> Ctrl : available
opt available
  Ctrl -> Ctrl : selectedSlot := s
end
[<-- Ctrl : available
@enduml
